{"seq":11,"ts":"2026-08-30T15:06:56.478Z","type":"tool.result","callId":"read_file-5","tool":"read_file","ok":true,"exitCode":null,"durationMs":1,"output":"// Builds every package in the order declared by build.order.json.\nimport { execFileSync } from 'node:child_process';\nimport { readFileSync } from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nconst root = path.dirname(path.dirname(fileURLToPath(import.meta.url)));\nconst { order } = JSON.parse(readFileSync(path.join(root, 'build.order.json'), 'utf8'));\n\nfor (const name of order) {\n  const packageDir = path.join(root, 'packages', name);\n  console.log(`building ${name}`);\n  execFileSync('tsc', ['-p', 'tsconfig.json'], { cwd: packageDir, stdio: 'inherit' });\n}\n"}
