# Copy to .env and fill in locally. Never commit a filled .env.
# The CLI reads these from the process environment; it does not load .env files by itself.
# Load them with your shell, for example:  set -a; . ./.env; set +a

# Required for `diagnose` and `eval`. Not required for `report`, `fixtures`, `apply` or `npm test`.
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint. Read by the OpenAI SDK underneath the agents
# library, not by this project's own code. Leave it unset to call OpenAI directly.
# The published evaluation was run through OpenRouter with this set to
# https://openrouter.ai/api/v1 and REPRO_DOCTOR_MODEL=openai/gpt-4.1-mini.
OPENAI_BASE_URL=

# Model pinned for a submitted run. Both modes always use the same value.
REPRO_DOCTOR_MODEL=gpt-4.1-mini

# Sandbox executor. "docker" is the only production value.
# "local-test-adapter" is test-only and is refused unless REPRO_DOCTOR_ALLOW_LOCAL_ADAPTER=1.
REPRO_DOCTOR_EXECUTOR=docker
REPRO_DOCTOR_ALLOW_LOCAL_ADAPTER=

# Docker image used as the sandbox. Build it with `npm run docker:build`.
REPRO_DOCTOR_RUNNER_IMAGE=repro-doctor-runner:1

# Optional price override in USD per million tokens. A live run whose model has
# no verified price is rejected before its first API call.
REPRO_DOCTOR_PRICE_INPUT_PER_MTOK=
REPRO_DOCTOR_PRICE_OUTPUT_PER_MTOK=

# "human" (default) or "json" for the structured stderr log stream.
REPRO_DOCTOR_LOG_FORMAT=human
